node_modules
out
.cache
.DS_Store
*.log
.env
.env.local

# public/audio/master-voiceover.mp3 is a Stage 1 copy of the canonical
# input/master-voiceover.mp3. Don't commit the duplicate — it's regenerated
# by the render workflow on every run.
public/audio/*.mp3

# Stage 1 outputs are generated by the `prepare-data` workflow and
# committed back to the branch by that workflow. Do not gitignore them
# (the workflow needs to `git add` them for the commit-back step).
#
# Stage 2 outputs (presentation.json, motion-plan.json, scene-timings.json)
# are authored by Claude and committed by hand.

# src/data/scenes.json is a placeholder fallback for the renderer when no
# Stage 2 files exist. Once Stage 2 files are committed, scenes.json is no
# longer consulted.
